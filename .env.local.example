# Plantilla de variables de entorno. Este archivo SÍ se versiona; el que
# lleva los valores de verdad, .env.local, NO (está en .gitignore).
#
# Cómo rellenarlo: copia este archivo como .env.local y pega cada valor
# desde Supabase, en Project Settings -> API de cada proyecto.
#
# La clave service_role salta TODAS las reglas de permisos: no debe aparecer
# nunca en el navegador, ni en un commit, ni en un chat. Solo las variables
# que empiezan por NEXT_PUBLIC_ llegan al navegador.

# --- Proyecto de PRODUCCIÓN (ropa-infantil-produccion) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Proyecto de PRUEBAS (ropa-infantil-pruebas) ---
# Contra este se ejecutan las pruebas de permisos. Nunca apunta a producción:
# una prueba borra y crea usuarios sin preguntar.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
