# Plantilla de variables de entorno. Este archivo SÍ se versiona; el que
# lleva los valores de verdad, .env.local, NO (está en .gitignore).
#
# Cómo rellenarlo: copia este archivo como .env.local y pega cada valor
# desde Supabase, en Project Settings -> API Keys de cada proyecto.
#
# Supabase usa el sistema nuevo de claves: la publicable empieza por
# sb_publishable_ y la secreta por sb_secret_. Las antiguas (anon y
# service_role, que empiezan por eyJ) están en camino de retirarse y no
# se usan aquí.
#
# La clave SECRETA salta TODAS las reglas de permisos: no debe aparecer
# nunca en el navegador, ni en un commit, ni en un chat. Solo las
# variables que empiezan por NEXT_PUBLIC_ llegan al navegador.

# --- Proyecto de PRODUCCIÓN (ropa-infantil-produccion) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Proyecto de PRUEBAS (ropa-infantil-pruebas) ---
# Contra este se ejecutan las pruebas de permisos. Nunca apunta a
# producción: una prueba borra y crea usuarios sin preguntar.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SECRET_KEY=
